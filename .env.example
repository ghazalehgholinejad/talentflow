# Generate .env.local and private n8n import files with: npm run setup:n8n
N8N_BASE_URL=https://your-account.app.n8n.cloud
N8N_MODE=mock
# Required; setup generates a random secret, shared only with your n8n workflow.
N8N_WEBHOOK_SECRET=
# Live providers are not configured in this release. Do not switch modes blindly.

# Optional standalone Python backend (no n8n account required):
# TALENTFLOW_BACKEND=python
# TALENTFLOW_PYTHON_URL=http://127.0.0.1:8000
# TALENTFLOW_API_KEY=
